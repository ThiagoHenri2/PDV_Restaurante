# Copie este arquivo para ".env" e ajuste os valores antes de rodar o projeto.
# "docker compose" lê automaticamente o arquivo ".env" na raiz do projeto.

# --- Banco de dados (Postgres) ---
POSTGRES_DB=pdv_restaurante
POSTGRES_USER=pdv_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-grande
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
